{
  "TV/RadioES": {
    "docker_image": "connector-tv-radio-image:latest",
    "connector_name": "TV/RadioES",
    "description": "Connector for Spanish TV and radio streams",
    "accepted_source_types": ["TV", "Radio"],
    "default_sources": ["24Horas", "Actualidad360", "RNERadio5TodoNoticiasMurcia"],
    "accepted_params": {
      "t": "total time to ingest in seconds",
      "sw": "segment wrap, Optional ffmpeg segment_wrap value (int > 0)",
      "st": "segment time, Optional segment_time: integer minutes or HH:MM:SS(.msec)"
    },
    "is_active": true
  },

  "TestConector": {
    "docker_image": "test_connector:latest",
    "connector_name": "Test conector",
    "description": "Test conector for development purposes",
    "default_sources": ["24Horas"],
    "is_active": true
  },

  "TestConector2": {
    "docker_image": "test_connector2:latest",
    "connector_name": "Test conector 2",
    "description": "Test conector 2 for development purposes",
    "accepted_sources": ["24Horas", "RNERadio5TodoNoticiasMurcia"],
    "default_sources": ["RNERadio5TodoNoticiasMurcia"],
    "is_active": true
  }

}